RunService:BindToRenderStep("DK_ESP", 1, function()
    if not ESPSettings.Enabled then
        for _, data in pairs(esp) do
            hideESP(data)
            if data.highlight then
                data.highlight.Enabled = false
            end
        end
        return
    end

    for plr, data in pairs(esp) do
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if not char or not hrp or not hum or hum.Health <= 0 then
            hideESP(data)
            if data.highlight then
                data.highlight.Enabled = false
            end
            continue
        end

        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            hideESP(data)
            if data.highlight then
                data.highlight.Enabled = false
            end
            continue
        end

        local topPos = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
        local bottomPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        local height = math.abs(topPos.Y - bottomPos.Y)
        local width = height * 0.6
        local x = pos.X - width / 2
        local y = pos.Y - height / 2

        data.box.Color = ESPSettings.BoxColor
        data.filled.Color = ESPSettings.FilledBoxColor
        data.name.Color = ESPSettings.NameColor
        for _, l in ipairs(data.cornerLines) do
            l.Color = ESPSettings.BoxColor
        end

        if ESPSettings.Chams then
            if not data.highlight then
                data.highlight = Instance.new("Highlight")
                data.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                data.highlight.FillTransparency = 0.5
                data.highlight.OutlineTransparency = 0
                data.highlight.Parent = char
            end
            data.highlight.Adornee = char
            data.highlight.FillColor = ESPSettings.ChamsColor
            data.highlight.Enabled = true
        else
            if data.highlight then
                data.highlight.Enabled = false
            end
        end

        if ESPSettings.FilledBox then
            data.filled.Visible = true
            data.filled.Position = Vector2.new(x, y)
            data.filled.Size = Vector2.new(width, height)
        else
            data.filled.Visible = false
        end

        if ESPSettings.Box then
            if ESPSettings.BoxType == "Normal" then
                for _, l in ipairs(data.cornerLines) do
                    l.Visible = false
                end
                for _, l in ipairs(data.cornerOutlines) do
                    l.Visible = false
                end
                data.outline.Visible = true
                data.outline.Position = Vector2.new(x, y)
                data.outline.Size = Vector2.new(width, height)
                data.box.Visible = true
                data.box.Position = Vector2.new(x, y)
                data.box.Size = Vector2.new(width, height)
            else
                data.box.Visible = false
                data.outline.Visible = false
                local len = width * 0.25
                local corners = {
                    { Vector2.new(x, y), Vector2.new(x + len, y) },
                    { Vector2.new(x, y), Vector2.new(x, y + len) },
                    { Vector2.new(x + width - len, y), Vector2.new(x + width, y) },
                    { Vector2.new(x + width, y), Vector2.new(x + width, y + len) },
                    { Vector2.new(x, y + height - len), Vector2.new(x, y + height) },
                    { Vector2.new(x, y + height), Vector2.new(x + len, y + height) },
                    { Vector2.new(x + width, y + height - len), Vector2.new(x + width, y + height) },
                    { Vector2.new(x + width - len, y + height), Vector2.new(x + width, y + height) }
                }
                for i, c in ipairs(corners) do
                    data.cornerOutlines[i].From = c[1]
                    data.cornerOutlines[i].To = c[2]
                    data.cornerOutlines[i].Visible = true
                    data.cornerLines[i].From = c[1]
                    data.cornerLines[i].To = c[2]
                    data.cornerLines[i].Visible = true
                end
            end
        else
            data.box.Visible = false
            data.outline.Visible = false
            for _, l in ipairs(data.cornerLines) do
                l.Visible = false
            end
            for _, l in ipairs(data.cornerOutlines) do
                l.Visible = false
            end
        end

        if ESPSettings.Healthbar and hum then
            local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local barW = 1.5
            local barX = ESPSettings.HealthbarSide == "Left" and (x - barW - 3) or (x + width + 3)
            data.bg.Visible = true
            data.bg.Position = Vector2.new(barX, y)
            data.bg.Size = Vector2.new(barW, height)
            for i = 1, SEGMENTS do
                local seg = data.segs[i]
                if i / SEGMENTS <= healthPercent then
                    seg.Visible = true
                    seg.Color = getGradient(i / SEGMENTS)
                    local segH = height / SEGMENTS
                    seg.Size = Vector2.new(barW, segH)
                    seg.Position = Vector2.new(barX, y + height - (segH * i))
                else
                    seg.Visible = false
                end
            end
        else
            data.bg.Visible = false
            for _, s in ipairs(data.segs) do
                s.Visible = false
            end
        end

        if ESPSettings.Name then
            data.name.Visible = true
            data.name.Text = plr.Name
            data.name.Position = Vector2.new(pos.X, y - 14)
        else
            data.name.Visible = false
        end
    end
end)

