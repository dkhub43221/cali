local function IsVisibleCheck(part)
    if not part then
        return false
    end
    local cam = workspace.CurrentCamera
    local origin = cam.CFrame.Position
    local direction = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = { player.Character, part.Parent }
    params.IgnoreWater = true
    local result = workspace:Raycast(origin, direction, params)
    return result == nil
end

local function getClosestToCenter()
    local closest = nil
    local shortest = math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, plr in pairs(PlayersService:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild(getgenv().SilentTargetPart) then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then
                continue
            end
            local part = plr.Character[getgenv().SilentTargetPart]
            if VisibleCheckEnabled and not IsVisibleCheck(part) then
                continue
            end
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = part
                end
            end
        end
    end
    SilentPart = closest
    return closest
end

local function getFOVTarget()
    local closest = nil
    local dist = FOVSize
    local mouse = UIS:GetMouseLocation()
    for _, plr in pairs(PlayersService:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild(getgenv().SilentTargetPart) then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then
                continue
            end
            local part = plr.Character[getgenv().SilentTargetPart]
            if VisibleCheckEnabled and not IsVisibleCheck(part) then
                continue
            end
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local mag = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                if mag < dist then
                    dist = mag
                    closest = part
                end
            end
        end
    end
    return closest
end

if not getgenv().SilentHooked then
    getgenv().SilentHooked = true
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self,...)
        local args = {... }
        local method = getnamecallmethod()
        if not checkcaller() and getgenv().SilentAimEnabled and SilentPart and SilentPart.Parent then
            if self == workspace then
                if method == "Raycast" then
                    if math.random(1, 100) <= HitChance then
                        local origin = args[1]
                        local direction = args[2]
                        if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
                            local dirToTarget = SilentPart.Position - origin
                            if dirToTarget.Magnitude > 0.1 then
                                args[2] = dirToTarget.Unit * direction.Magnitude
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
            end
        end
        return oldNamecall(self,...)
    end)
    setreadonly(mt, true)
end

local visualTarget = nil
local frameCount = 0

RunService.RenderStepped:Connect(function()
    frameCount += 1
    local mouse = UIS:GetMouseLocation()
    if FOVEnabled then
        outer.Visible = true
        mid.Visible = true
        inner.Visible = true
        outer.Position = UDim2.fromOffset(mouse.X - FOVSize - 1, mouse.Y - FOVSize - 1)
        outer.Size = UDim2.fromOffset((FOVSize + 1) * 2, (FOVSize + 1) * 2)
        mid.Position = UDim2.fromOffset(mouse.X - FOVSize, mouse.Y - FOVSize)
        mid.Size = UDim2.fromOffset(FOVSize * 2, FOVSize * 2)
        inner.Position = UDim2.fromOffset(mouse.X - FOVSize + 1, mouse.Y - FOVSize + 1)
        inner.Size = UDim2.fromOffset((FOVSize - 1) * 2, (FOVSize - 1) * 2)
    else
        outer.Visible = false
        mid.Visible = false
        inner.Visible = false
    end
    if getgenv().SilentAimEnabled then
        if frameCount % 2 == 0 then
            getClosestToCenter()
            visualTarget = getFOVTarget()
        end
    else
        SilentPart = nil
        visualTarget = nil
    end
    if SnapEnabled and visualTarget and getgenv().SilentAimEnabled then
        local pos, onScreen = Camera:WorldToViewportPoint(visualTarget.Position)
        if onScreen then
            local dir = Vector2.new(pos.X, pos.Y) - mouse
            local len = dir.Magnitude
            if len <= FOVSize + 50 then
                local deg = math.deg(math.atan2(dir.Y, dir.X))
                snapOuter.Visible = true
                snap.Visible = true
                snapOuter.Size = UDim2.fromOffset(len, SnapThick + 2)
                snap.Size = UDim2.fromOffset(len, SnapThick)
                snapOuter.Position = UDim2.fromOffset(mouse.X, mouse.Y)
                snap.Position = UDim2.fromOffset(mouse.X, mouse.Y)
                snapOuter.Rotation = deg
                snap.Rotation = deg
            else
                snap.Visible = false
                snapOuter.Visible = false
            end
        else
            snap.Visible = false
            snapOuter.Visible = false
        end
    else
        snap.Visible = false
        snapOuter.Visible = false
    end
end)

