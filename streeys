            esp[p].box:Remove()
            esp[p].filled:Remove()
            esp[p].outline:Remove()
            esp[p].bg:Remove()
            esp[p].name:Remove()
            for _, c in ipairs(esp[p].cornerLines) do
                c:Remove()
            end
            for _, c in ipairs(esp[p].cornerOutlines) do
                c:Remove()
            end
            for _, s in ipairs(esp[p].segs) do
