local function lerpColor(c1, c2, t)
    return Color3.new(c1.R + (c2.R - c1.R) * t, c1.G + (c2.G - c1.G) * t, c1.B + (c2.B - c1.B) * t)
end

local function getGradient(t)
    t = math.clamp(t, 0, 1)
    if t < 0.5 then
        return lerpColor(Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 255, 0), t * 2)
    else
        return lerpColor(Color3.fromRGB(255, 255, 0), Color3.fromRGB(0, 255, 0), (t - 0.5) * 2)
    end
end

local function createDrawings(p)
    if p == player then
        return
    end
    if esp[p] then
        return
    end
    pcall(function()
        local box = Drawing.new("Square")
        box.Thickness = 1.5
        box.Filled = false
        box.Color = ESPSettings.BoxColor
        box.Visible = false
        box.ZIndex = 2

        local filled = Drawing.new("Square")
        filled.Thickness = 0
        filled.Filled = true
        filled.Color = ESPSettings.FilledBoxColor
        filled.Transparency = 0.6
        filled.Visible = false
        filled.ZIndex = 1

        local outline = Drawing.new("Square")
        outline.Thickness = 3
        outline.Filled = false
        outline.Color = Color3.fromRGB(0, 0, 0)
        outline.Visible = false
        outline.ZIndex = 1

        local cornerLines = {}
        local cornerOutlines = {}

        for i = 1, 8 do
            local l = Drawing.new("Line")
            l.Thickness = 1.5
            l.Color = ESPSettings.BoxColor
            l.Visible = false
            l.ZIndex = 2
            table.insert(cornerLines, l)

            local ol = Drawing.new("Line")
            ol.Thickness = 3.5
            ol.Color = Color3.fromRGB(0, 0, 0)
            ol.Visible = false
            ol.ZIndex = 1
            table.insert(cornerOutlines, ol)
        end

        local bg = Drawing.new("Square")
        bg.Thickness = 1
        bg.Filled = true
        bg.Color = Color3.fromRGB(0, 0, 0)
        bg.Visible = false
        bg.ZIndex = 1

        local segs = {}
        for i = 1, SEGMENTS do
            local s = Drawing.new("Square")
            s.Thickness = 0
            s.Filled = true
            s.Visible = false
            s.ZIndex = 2
            table.insert(segs, s)
        end

        local nameText = Drawing.new("Text")
        nameText.Size = 13
        nameText.Center = true
        nameText.Outline = true
        nameText.OutlineColor = Color3.fromRGB(0, 0, 0)
        nameText.Color = ESPSettings.NameColor
        nameText.Visible = false
        nameText.ZIndex = 3
        nameText.Font = 2

        esp[p] = {
            box = box,
            filled = filled,
            outline = outline,
            cornerLines = cornerLines,
            cornerOutlines = cornerOutlines,
            bg = bg,
            segs = segs,
            name = nameText,
            highlight = nil
        }
    end)
end

local function hideESP(data)
    if not data then
        return
    end
    data.box.Visible = false
    data.filled.Visible = false
    data.outline.Visible = false
    data.bg.Visible = false
    data.name.Visible = false
    for _, v in ipairs(data.cornerLines) do
        v.Visible = false
    end
    for _, v in ipairs(data.cornerOutlines) do
        v.Visible = false
    end
    for _, v in ipairs(data.segs) do
        v.Visible = false
    end
end

