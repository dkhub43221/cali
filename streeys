local function HasTool(name)
    local char = player.Character
    return char and (char:FindFirstChild(name) or player.Backpack:FindFirstChild(name))
end

local function CountTool(name)
    local c = 0
    local char = player.Character
    if char then
        for _, t in pairs(char:GetChildren()) do
            if t.Name == name then
                c += 1
            end
        end
    end
    for _, t in pairs(player.Backpack:GetChildren()) do
        if t.Name == name then
            c += 1
        end
    end
    return c
end

local function CountActivated()
    local c = 0
    local char = player.Character
    if char then
        for _, t in pairs(char:GetChildren()) do
            if t.Name:lower():find("activated") then
                c += 1
            end
        end
    end
    for _, t in pairs(player.Backpack:GetChildren()) do
        if t.Name:lower():find("activated") then
            c += 1
        end
    end
    return c
end

local function GetActivatedBlank()
    local char = player.Character
    local bp = player.Backpack
    for _, v in pairs({char, bp}) do
        if not v then
            continue
        end
        for _, tool in pairs(v:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find("activated") and tool.Name:lower():find("blank") then
                return tool
            end
        end
    end
    return nil
end

local function IsEquipped(name)
    local char = player.Character
    return char and char:FindFirstChild(name) ~= nil
end

local function EquipToolSafe(tool)
    if not tool then
        return false
    end
    local char = GetChar()
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then
        return false
    end
    if hum.SeatPart then
        hum:UnequipTools()
        task.wait(0.1)
    end
    hum:EquipTool(tool)
    task.wait(0.4)
    return tool.Parent == char
end

