local gunMods = {
    Auto = false,
    NoRecoil = false,
    NoSpread = false,
    InfAmmo = false,
    Burst = false
}

local Originals = {}
local backpack = player:WaitForChild("Backpack")

local function GetSettings(tool)
    local ok, res = pcall(function()
        local f = tool:FindFirstChild("Setting")
        if not f then
            return nil
        end
        local m = f:FindFirstChild("1")
        if not m or not m:IsA("ModuleScript") then
            return nil
        end
        return require(m)
    end)
    if ok and type(res) == "table" then
        return res
    end
    return nil
end

local function CacheOriginals(tool, s)
    if Originals[tool] then
        return
    end
    Originals[tool] = {
        Auto = s.Auto,
        Spread = s.Spread,
        Recoil = s.Recoil,
        Shake = s.Shake,
        TacticalReloadTime = s.TacticalReloadTime,
        ReloadTime = s.ReloadTime,
        AmmoPerMag = s.AmmoPerMag,
        LimitedAmmoEnabled = s.LimitedAmmoEnabled,
        Ammo = s.Ammo,
        StoredAmmo = s.StoredAmmo,
        BurstFireEnabled = s.BurstFireEnabled,
        BulletPerBurst = s.BulletPerBurst,
        MaximumFireRate = s.MaximumFireRate,
        FireRate = s.FireRate,
        GunKick = s.GunKick
    }
end

local function ApplyGunSettings(tool)
    local s = GetSettings(tool)
    if not s then
        return
    end
    local ro = isreadonly(s)
    if ro then
        setreadonly(s, false)
    end
    CacheOriginals(tool, s)
    local o = Originals[tool]
    if gunMods.Auto then
        s.Auto = true
    else
        s.Auto = o.Auto
    end
    if gunMods.NoSpread then
        s.Spread = 0
        s.Shake = 0
        s.GunKick = 0
    else
        s.Spread = o.Spread
        s.Shake = o.Shake
        s.GunKick = o.GunKick
    end
    if gunMods.NoRecoil then
        s.Recoil = 0
    else
        s.Recoil = o.Recoil
    end
    if gunMods.InfAmmo then
        s.TacticalReloadTime = 0
        s.ReloadTime = 0
        s.AmmoPerMag = 999999
        s.LimitedAmmoEnabled = false
        s.Ammo = 999999
        if s.StoredAmmo ~= nil then
            s.StoredAmmo = 999999
        end
    else
        s.TacticalReloadTime = o.TacticalReloadTime
        s.ReloadTime = o.ReloadTime
        s.AmmoPerMag = o.AmmoPerMag
        s.LimitedAmmoEnabled = o.LimitedAmmoEnabled
        s.Ammo = o.Ammo
        if o.StoredAmmo ~= nil then
            s.StoredAmmo = o.StoredAmmo
        end
    end
    if gunMods.Burst then
        s.BurstFireEnabled = true
        s.BulletPerBurst = 5
        s.MaximumFireRate = 0.08
        s.FireRate = 0.08
        s.Auto = true
    else
        s.BurstFireEnabled = o.BurstFireEnabled
        s.BulletPerBurst = o.BulletPerBurst
        s.MaximumFireRate = o.MaximumFireRate
        s.FireRate = o.FireRate
        if not gunMods.Auto then
            s.Auto = o.Auto
        end
    end
    if ro then
        setreadonly(s, true)
    end
end

local function ApplyToAllGuns()
    for _, tool in ipairs(backpack:GetChildren()) do
        pcall(ApplyGunSettings, tool)
    end
    if player.Character then
        for _, tool in ipairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") then
                pcall(ApplyGunSettings, tool)
            end
        end
    end
end

