local function tpTweenGeneric(targetPos, checkFunc, walkSpeed)
    if _G.StopTP then
        return false
    end
    local char = GetChar()
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then
        return false
    end
    EnableNoclip()
    if _G.TPMethod == "Tween" then
        local distance = (root.Position - targetPos).Magnitude
        local time = distance / 10
        CurrentTween = TweenService:Create(root, TweenInfo.new(time, Enum.EasingStyle.Linear), {
            CFrame = CFrame.new(targetPos)
        })
        CurrentTween:Play()
        repeat
            task.wait(0.1)
            if _G.StopTP then
                if CurrentTween then
                    CurrentTween:Cancel()
                end
                DisableNoclip()
                return false
            end
            if checkFunc and not checkFunc() then
                DisableNoclip()
                return false
            end
        until (root.Position - targetPos).Magnitude <= 6 or _G.StopTP or (checkFunc and not checkFunc())
        DisableNoclip()
        return true
    else
        hum.WalkSpeed = walkSpeed or 16
        repeat
            if _G.StopTP then
                DisableNoclip()
                return false
            end
            if checkFunc and not checkFunc() then
                DisableNoclip()
                return false
            end
            hum:MoveTo(targetPos)
            task.wait(0.15)
        until (root.Position - targetPos).Magnitude <= 6 or _G.StopTP or (checkFunc and not checkFunc())
        DisableNoclip()
        return true
    end
end

local function tpInstant(targetPos)
    local char = GetChar()
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        return false
    end
    char:PivotTo(CFrame.new(targetPos))
    root.CFrame = CFrame.new(targetPos)
    root.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.15)
    return true
end

