local function IsGun(tool)
    return tool:IsA("Tool") and tool:FindFirstChild("Handle") and tool:FindFirstChild("Setting")
end

local function GetMyGun()
    local char = player.Character
    if not char then
        return nil
    end
    local tool = char:FindFirstChildWhichIsA("Tool")
    if tool and IsGun(tool) then
        return tool
    end
    return nil
end

local function FireAtPart(targetPart)
    local myGun = GetMyGun()
    if not myGun or not targetPart then
        return
    end
    local handle = myGun:FindFirstChild("Handle")
    if not handle then
        return
    end
    local dist = (handle.Position - targetPart.Position).Magnitude
    local Event = game:GetService("ReplicatedStorage").Remotes:FindFirstChild("InflictTarget")
    if not Event then
        return
    end
    Event:FireServer("Gun", myGun, targetPart, {
        {
            ChargeLevel = 0,
            ClientHitSize = targetPart.Size,
            Distance = dist,
            ModuleName = "1",
            BulletId = "31,12|Bullet_{".. game:GetService("HttpService"):GenerateGUID(false).. "}"
        },
        {
            ChargeLevel = false,
            ClientHitSize = false,
            Distance = false,
            ModuleName = false,
            BulletId = true
        }
    })
end

